{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/explore",
      "destination": "/explore/index.html"
    },
    {
      "source": "/explore/",
      "destination": "/explore/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "crons": [
    {
      "path": "/api/sla-check",
      "schedule": "0 9 * * *"
    }
  ]
}
